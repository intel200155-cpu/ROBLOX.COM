local function D(S, K)
    local R = {}
    for i = 1, #S do
        local B = string.byte(S, i, i)
        local O = string.byte(K, (i - 1) % #K + 1, (i - 1) % #K + 1)
        R[i] = string.char(bit32.bxor(B, O))
    end
    return table.concat(R)
end

